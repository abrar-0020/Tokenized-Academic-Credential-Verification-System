# Replace with your deployed contract address
VITE_CONTRACT_ADDRESS=0x5FbDB2315678afecb367f032d93F642f64180aa3

# Network ID (31337 for localhost, 11155111 for Sepolia)
VITE_NETWORK_ID=31337
VITE_NETWORK_NAME=localhost

# IPFS Gateway (Pinata public gateway for reading CIDs)
VITE_IPFS_GATEWAY=https://gateway.pinata.cloud/ipfs/

# Server-Only Pinata & Encryption Secrets (NEVER prefix with VITE_)
# Configure these in root .env (local) or Vercel Serverless Environment Variables (production):
# IPFS_API_KEY=your_pinata_api_key_here
# IPFS_SECRET_KEY=your_pinata_secret_here
# CREDENTIAL_MASTER_KEY=your_long_random_aes256_master_secret_here
