{

  "name": "tokenized-academic-credentials",
  "version": "1.0.0",
  "description": "Blockchain-based Academic Credential Verification System",
  "main": "index.js",
  "scripts": {
    "install-all": "npm install && cd frontend && npm install && cd ..",
    "compile": "hardhat compile",
    "test": "hardhat test",
    "test:coverage": "hardhat coverage",
    "deploy:local": "hardhat run scripts/deploy.js --network localhost",
    "deploy:sepolia": "hardhat run scripts/deploy.js --network sepolia",
    "node": "hardhat node",
    "frontend": "cd frontend && npm run dev",
    "interact": "hardhat run scripts/interact.js --network localhost",
    "issue": "hardhat run scripts/issueCredential.js --network localhost",
    "clean": "hardhat clean",
    "size": "hardhat size-contracts"
  },
  "keywords": [
    "blockchain",
    "ethereum",
    "credentials",
    "nft",
    "soulbound"
  ],
  "author": "",
  "license": "MIT",
  "devDependencies": {
    "@nomicfoundation/hardhat-chai-matchers": "^2.1.0",
    "@nomicfoundation/hardhat-ethers": "^3.1.3",
    "@nomicfoundation/hardhat-network-helpers": "^1.1.2",
    "@nomicfoundation/hardhat-toolbox": "^4.0.0",
    "@nomicfoundation/hardhat-verify": "^2.1.3",
    "@typechain/ethers-v6": "^0.5.1",
    "@typechain/hardhat": "^9.1.0",
    "@types/chai": "^4.3.20",
    "@types/mocha": "^10.0.10",
    "@types/node": ">=18.0.0",
    "chai": "^4.5.0",
    "hardhat": "^2.19.5",
    "hardhat-gas-reporter": "^1.0.10",
    "solidity-coverage": "^0.8.17",
    "ts-node": "^10.9.2",
    "typechain": "^8.3.2",
    "typescript": "^5.0.0"
  },
  "dependencies": {
    "@openzeppelin/contracts": "^5.0.1",
    "axios": "^1.6.5",
    "cobe": "^2.0.1",
    "dotenv": "^16.4.1",
    "ethers": "^6.16.0",
    "form-data": "^4.0.0"
  }
}
