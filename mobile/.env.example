# TokCred Mobile App Environment
# Copy this to .env.local and fill in your values

# Network (11155111 = Sepolia, 1 = Mainnet)
EXPO_PUBLIC_NETWORK_ID=11155111

# Contract address (deployed Sepolia contract from web app)
EXPO_PUBLIC_CONTRACT_ADDRESS=0xE8cb94E530Ee82c0EEbDB2FB092Bd32eDDD1dab1

# Public RPC URL (no API key needed for Sepolia public node)
EXPO_PUBLIC_RPC_URL=https://ethereum-sepolia-rpc.publicnode.com

# IPFS Gateway
EXPO_PUBLIC_IPFS_GATEWAY=https://gateway.pinata.cloud/ipfs/

# Optional: Pinata credentials for client-side IPFS upload (issuers only)
# EXPO_PUBLIC_PINATA_API_KEY=your_key_here
# EXPO_PUBLIC_PINATA_SECRET_KEY=your_secret_here

# Optional: Server proxy URL for IPFS upload (preferred over client-side keys)
# EXPO_PUBLIC_API_URL=https://your-server.com
