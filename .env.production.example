# Production Environment Configuration
# Copy this to .env.production and fill in your values

# Deployed Contract Address (from your mainnet/testnet deployment)
VITE_CONTRACT_ADDRESS=0x_your_deployed_contract_address_here

# Network Configuration
# Ethereum Mainnet: 1
# Sepolia Testnet: 11155111
# Polygon: 137
VITE_NETWORK_ID=1
VITE_NETWORK_NAME=mainnet

# IPFS Gateway (Pinata public read gateway)
VITE_IPFS_GATEWAY=https://gateway.pinata.cloud/ipfs/

# Server-Only Credentials (configure on Vercel/server, NEVER prefix with VITE_):
IPFS_API_KEY=your_pinata_api_key_here
IPFS_SECRET_KEY=your_pinata_secret_here
CREDENTIAL_MASTER_KEY=your_long_random_aes256_master_secret_here

# IMPORTANT: Never commit your actual .env.production with real credentials!
