# Network Configuration
SEPOLIA_RPC_URL=https://eth-sepolia.g.alchemy.com/v2/YOUR_ALCHEMY_API_KEY
PRIVATE_KEY=your_wallet_private_key_here

# Server-Only IPFS (Pinata) & AES-256-GCM Encryption Secrets (never prefix with VITE_)
IPFS_API_KEY=your_pinata_api_key_here
IPFS_SECRET_KEY=your_pinata_secret_here
CREDENTIAL_MASTER_KEY=your_long_random_aes256_master_secret_here

# Contract Addresses (After Deployment)
CONTRACT_ADDRESS=0x5FbDB2315678afecb367f032d93F642f64180aa3

# Public Frontend Environment Variables (Safe for browser bundle)
VITE_CONTRACT_ADDRESS=0x5FbDB2315678afecb367f032d93F642f64180aa3
VITE_NETWORK_ID=31337
VITE_NETWORK_NAME=localhost
VITE_IPFS_GATEWAY=https://gateway.pinata.cloud/ipfs/
